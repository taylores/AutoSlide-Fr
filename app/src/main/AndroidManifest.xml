<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--允许应用访问网络(主要用于检查更新)-->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--允许安装APK-->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="RequestInstallPackagesPolicy" />
    <!--添加悬浮窗权限-->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--添加写入安全设置权限-->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!--自动后退震动提示所需权限-->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/auto_slide"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoSlide">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MacroPlanActivity"
            android:exported="false"
            android:label="@string/title_macro_plans" />
        <activity
            android:name=".MacroEditorActivity"
            android:exported="false" />

        <activity
            android:name=".ScreenTextActivity"
            android:exported="false"
            android:theme="@style/Theme.AutoSlide.Transparent"
            android:label="@string/macro_inspect_text" />
        <service
            android:name=".service.InspectFloatingService"
            android:enabled="true"
            android:exported="false" />

        <service
            android:name=".service.AutoSlideService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            tools:ignore="AccessibilityPolicy">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <service
            android:name=".service.FloatingWindowService"
            android:enabled="true"
            android:exported="false" />
        <!-- 快捷磁贴开关服务 -->
        <service
            android:name=".service.AutoSlideTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_slide_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- 屏幕文字检查磁贴 -->
        <service
            android:name=".service.InspectTextTileService"
            android:label="@string/macro_inspect_text"
            android:icon="@drawable/ic_floating_settings"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!--用于与Shizuku服务建立通信-->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>